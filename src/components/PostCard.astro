---
import Tag from "./Tag.astro";
import { formatShortDate } from "../utils/formatDate";
import { calculateReadingTime } from "../utils/readingTime";

interface Props {
    slug: string;
    title: string;
    description: string;
    date: Date;
    tags?: string[];
    body?: string;
    showTags?: boolean;
    showReadingTime?: boolean;
}

const {
    slug,
    title,
    description,
    date,
    tags = [],
    body = "",
    showTags = true,
    showReadingTime = false,
} = Astro.props;
---

<article
    class="group relative flex flex-col gap-2 border-t border-[var(--page-border)] pt-4 transition-all duration-200 hover:-translate-y-1 hover:border-[var(--page-muted)] cursor-pointer"
>
    <div class="flex items-start justify-between gap-4">
        <a
            class="stretched-link text-xl font-semibold group-hover:underline"
            href={`/posts/${slug}/`}
        >
            {title}
            <span
                aria-hidden="true"
                class="ml-2 inline-block opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0"
                >→</span
            >
        </a>
        <div class="flex flex-col items-end gap-1 shrink-0">
            <time class="date-label" datetime={date.toISOString()}>
                {formatShortDate(date)}
            </time>
            {
                showReadingTime && body && (
                    <span class="text-[0.65rem] uppercase tracking-[0.2em] text-[var(--page-muted)] opacity-70">
                        {calculateReadingTime(body)}
                    </span>
                )
            }
        </div>
    </div>
    {
        showTags && tags.length > 0 && (
            <div class="relative z-10 flex flex-wrap gap-1">
                {tags.map((tag) => (
                    <Tag name={tag} />
                ))}
            </div>
        )
    }
    <p class="muted text-sm leading-relaxed">{description}</p>
</article>
